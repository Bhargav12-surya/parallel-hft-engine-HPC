{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hftlab.local/schemas/simulation-v1",
  "title": "Parallel and GPU-Accelerated High-Frequency Trading Simulation Engine simulation configuration v1",
  "type": "object",
  "required": ["schema_version", "dataset"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1}, "dataset": {"type": "string", "minLength": 1},
    "engine": {"enum": ["sequential", "threaded", "openmp", "mpi", "cuda", "hybrid"]},
    "cpu_mode": {"enum": ["single-single", "single-multi", "multi-single", "multi-multi"]},
    "strategy": {"enum": ["market-making", "momentum", "mean-reversion", "stat-arb", "ai", "hold"]},
    "threads": {"type": "integer", "minimum": 1, "maximum": 1024},
    "components": {"type": "array", "uniqueItems": true, "items": {"enum": ["cpu", "openmp", "mpi", "cuda"]}},
    "capital": {"type": "number", "exclusiveMinimum": 0}, "fee_bps": {"type": "number", "minimum": 0, "maximum": 10000},
    "slippage_ticks": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "latency_ns": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
    "position_limit": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "max_order": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "max_loss": {"type": "number", "minimum": 0}, "model": {"type": ["string", "null"]},
    "output_dir": {"type": "string"}, "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400}
  }
}

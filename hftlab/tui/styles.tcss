/* Research terminal: near-black, cyan, emerald and slate. */
Screen {
    background: #0a1018;
    color: #d5dfeb;
}
Header { background: #111d2c; color: #6ce2ed; }
Footer { background: #111d2c; }
#workspace { height: 1fr; }
#sidebar {
    width: 27;
    background: #0e1723;
    border-right: solid #213448;
    padding: 1 1;
    overflow-y: auto;
}
#brand { height: auto; text-align: center; margin-bottom: 1; }
#offline { color: #7091a6; margin-top: 2; height: 3; text-align: center; }
.nav { width: 100%; margin-bottom: 0; background: transparent; border: none; text-align: left; min-width: 0; }
.nav:hover { background: #17293a; }
.nav.active { color: #61e0e9; background: #173142; text-style: bold; }
#main { width: 1fr; }
#status-line { height: 2; padding: 0 2; color: #8eaabd; background: #101b28; }
#pages { height: 1fr; }
.page { padding: 1 3; height: 100%; }
.hero { color: #64e6ee; text-style: bold; height: auto; min-height: 3; content-align: left middle; }
.subtitle { color: #85a4b9; height: 2; }
.intro { margin-bottom: 1; height: auto; }
.page-title { color: #69e4ec; text-style: bold; height: 2; margin-bottom: 1; }
.section-label { color: #6ad8d8; text-style: bold; margin-top: 1; height: 2; }
.muted { color: #7b96ad; height: auto; margin: 1 0; }
.card { background: #101e2b; border: solid #243c50; padding: 1 2; margin: 1 0; height: auto; }
.button-row { height: auto; min-height: 3; margin: 1 0; }
.button-row Button { margin-right: 1; width: auto; min-width: 12; }
.form-row { height: auto; }
.field { height: auto; width: 1fr; margin-right: 2; }
.small-field { width: 22; }
Label { color: #99b4c9; margin-top: 1; }
Input { background: #0f1a27; border: tall #294359; }
Input:focus { border: tall #4bd4e1; }
Select { margin: 0 0 1 0; }
Button { background: #152a3a; color: #d9edf4; border: tall #29465c; }
Button.-primary { background: #087c8c; }
Button.-success { background: #14724e; }
Button.-error { background: #743b47; }
Button:focus { border: tall #6feaf0; }
DataTable { height: 1fr; min-height: 7; background: #0c1722; margin-top: 1; }
DataTable > .datatable--header { background: #193042; color: #8de6ee; text-style: bold; }
#home-history { height: 9; }
#datasets-table { height: 10; }
#benchmark-table { height: 12; }
RichLog { background: #0b1622; border: solid #21374a; padding: 1; height: 1fr; min-height: 8; margin-top: 1; }
#data-log, #training-log, #doctor-log { height: 20; }
#monitor-log { height: 1fr; }
#monitor-metrics, #monitor-trading { margin: 0 0 1 0; }
#simulation-progress { margin: 1 0; }
#hybrid-components { height: 8; background: #102334; }
#result-tabs { height: 1fr; }
TabbedContent ContentSwitcher { height: 1fr; }
TabPane { padding: 1; }
.error { color: #ef8194; height: auto; margin-top: 1; }
ConfirmScreen { align: center middle; background: #050b11 80%; }
#confirm-dialog { width: 65; height: auto; background: #132637; border: thick #3ac3d2; padding: 2 3; }
#confirm-message { height: auto; margin: 0 0 1 0; color: #e1f5fa; }
.compact .page { padding: 0 1; }
.compact .card { padding: 0 1; margin: 0; }
.narrow #sidebar { width: 20; padding: 1 0; }
.narrow .page { padding: 1; }
.narrow .small-field { width: 15; }
.tiny #sidebar { width: 14; }
.tiny .nav { padding: 0; text-align: left; }
.tiny #offline { display: none; }
.tiny .button-row { layout: vertical; }
.tiny .button-row Button { width: 100%; margin-bottom: 1; }
.tiny .form-row { layout: vertical; }
.tiny .field, .tiny .small-field { width: 100%; }

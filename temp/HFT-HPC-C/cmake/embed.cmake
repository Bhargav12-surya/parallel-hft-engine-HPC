set(TEXT "")
foreach(INPUT types.h numeric.h simulation.h backprop.h)
 file(READ "${ROOT}/include/hft/${INPUT}" PART)
 string(REGEX REPLACE "#include \"[^\"]+\"" "" PART "${PART}")
 string(APPEND TEXT "${PART}\n")
endforeach()
file(READ "${ROOT}/kernels/compute.c" PART)
string(APPEND TEXT "${PART}")
file(WRITE "${DEST}.txt" "${TEXT}")
file(READ "${DEST}.txt" BYTES HEX)
string(REGEX REPLACE "(................................)" "\\1\n" BYTES "${BYTES}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${BYTES}")
file(WRITE "${DEST}" "static const char hft_kernel_source[] = {${BYTES}0};\n")
file(REMOVE "${DEST}.txt")
